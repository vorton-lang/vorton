{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vorton.check-benchmark.disabled-path-gate.schema.v2",
  "title": "Vorton disabled phase-timing AB/BA evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_utc",
    "contract",
    "repository",
    "stage",
    "tools",
    "flags",
    "environment",
    "subjects",
    "warmups",
    "pairs",
    "claimed_summary",
    "claimed_verdict"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "vorton.check-benchmark.disabled-path-gate.v2"
    },
    "created_utc": { "type": "string", "minLength": 1 },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_pairs",
        "measured_pairs",
        "even_order",
        "odd_order",
        "delta_definition",
        "median_ratio_max",
        "median_delta_ns_max",
        "expected_exit_code",
        "expected_stdout_base64",
        "expected_stderr_base64",
        "phase_environment_prefix",
        "git_archive_core_autocrlf",
        "prelude_paths"
      ],
      "properties": {
        "warmup_pairs": { "type": "integer", "const": 5 },
        "measured_pairs": { "type": "integer", "const": 41 },
        "even_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/subject_name" }
        },
        "odd_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/subject_name" }
        },
        "delta_definition": {
          "type": "string",
          "const": "candidate_minus_base"
        },
        "median_ratio_max": { "type": "number", "const": 1.02 },
        "median_delta_ns_max": { "type": "integer", "const": 2000000 },
        "expected_exit_code": { "type": "integer", "const": 0 },
        "expected_stdout_base64": { "type": "string", "const": "T0sNCg==" },
        "expected_stderr_base64": { "type": "string", "const": "" },
        "phase_environment_prefix": { "type": "string", "const": "VORTON_PHASE_" },
        "git_archive_core_autocrlf": { "type": "string", "const": "false" },
        "prelude_paths": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "std/[a-z]+\\.vorton" }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "base_commit", "candidate_commit"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "base_commit": { "$ref": "#/$defs/commit" },
        "candidate_commit": { "$ref": "#/$defs/commit" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "source",
        "build",
        "thinlto_cache",
        "subject_base",
        "subject_candidate",
        "invocation_binary",
        "fixture",
        "std",
        "cwd"
      ],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "thinlto_cache": { "type": "string", "minLength": 1 },
        "subject_base": { "type": "string", "minLength": 1 },
        "subject_candidate": { "type": "string", "minLength": 1 },
        "invocation_binary": { "type": "string", "minLength": 1 },
        "fixture": { "type": "string", "minLength": 1 },
        "std": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git", "clang", "clangxx", "lld_link", "python"],
      "properties": {
        "git": { "$ref": "#/$defs/tool" },
        "clang": { "$ref": "#/$defs/tool" },
        "clangxx": { "$ref": "#/$defs/tool" },
        "lld_link": { "$ref": "#/$defs/tool" },
        "python": { "$ref": "#/$defs/tool" }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "runtime", "link"],
      "properties": {
        "compiler": { "$ref": "#/$defs/string_array" },
        "runtime": { "$ref": "#/$defs/string_array" },
        "link": { "$ref": "#/$defs/string_array" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "power_before",
        "power_after",
        "removed_phase_environment"
      ],
      "properties": {
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os_system",
            "os_release",
            "os_version",
            "machine",
            "cpu",
            "logical_cores",
            "total_memory_bytes"
          ],
          "properties": {
            "os_system": { "type": "string", "minLength": 1 },
            "os_release": { "type": "string", "minLength": 1 },
            "os_version": { "type": "string", "minLength": 1 },
            "machine": { "type": "string", "minLength": 1 },
            "cpu": { "type": "string", "minLength": 1 },
            "logical_cores": { "type": "integer", "minimum": 1 },
            "total_memory_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "power_before": { "$ref": "#/$defs/power" },
        "power_after": { "$ref": "#/$defs/power" },
        "removed_phase_environment": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "(?i:VORTON_PHASE_.*)" }
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/subject" }
    },
    "warmups": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/pair" }
    },
    "pairs": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": { "$ref": "#/$defs/pair" }
    },
    "claimed_summary": { "$ref": "#/$defs/summary" },
    "claimed_verdict": { "type": "string", "enum": ["PASS", "FAIL"] }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "subject_name": {
      "type": "string",
      "enum": ["base", "candidate"]
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "optional_file": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_scheme",
        "ac_line_status",
        "battery_flag",
        "battery_life_percent"
      ],
      "properties": {
        "active_scheme": { "type": "string", "minLength": 1 },
        "ac_line_status": { "type": "integer", "minimum": 0, "maximum": 255 },
        "battery_flag": { "type": "integer", "minimum": 0, "maximum": 255 },
        "battery_life_percent": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "argv",
        "cwd",
        "timeout_seconds",
        "wall_ns",
        "exit_code",
        "timed_out",
        "measurement_errors",
        "stdout",
        "stderr"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["anchor_compile", "runtime_compile", "link"]
        },
        "argv": { "$ref": "#/$defs/string_array" },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "const": 1200 },
        "wall_ns": { "type": "integer", "minimum": 1 },
        "exit_code": { "type": "integer", "const": 0 },
        "timed_out": { "type": "boolean", "const": false },
        "measurement_errors": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "stdout": { "$ref": "#/$defs/file" },
        "stderr": { "$ref": "#/$defs/file" }
      }
    },
    "linker_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "probe_argv",
        "cwd",
        "claimed_path",
        "selected_path",
        "exit_code",
        "stdout",
        "stderr"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "vorton.check-benchmark.linker-binding.v1"
        },
        "probe_argv": { "$ref": "#/$defs/string_array" },
        "cwd": { "type": "string", "minLength": 1 },
        "claimed_path": { "type": "string", "minLength": 1 },
        "selected_path": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer", "const": 0 },
        "stdout": { "$ref": "#/$defs/file" },
        "stderr": { "$ref": "#/$defs/file" }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "raw_sha256",
        "coff_normalized_sha256",
        "coff_timestamp_offset",
        "coff_timestamp_value"
      ],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "coff_normalized_sha256": { "$ref": "#/$defs/sha256" },
        "coff_timestamp_offset": { "type": "integer", "minimum": 0 },
        "coff_timestamp_value": { "type": "integer", "minimum": 0 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "commit",
        "build_sequence",
        "anchor",
        "runtime",
        "fixture",
        "prelude_files",
        "gate",
        "schema_contract",
        "harness",
        "windows_job",
        "binary",
        "build",
        "linker_binding"
      ],
      "properties": {
        "subject": { "$ref": "#/$defs/subject_name" },
        "commit": { "$ref": "#/$defs/commit" },
        "build_sequence": { "type": "integer", "minimum": 0, "maximum": 1 },
        "anchor": { "$ref": "#/$defs/file" },
        "runtime": { "$ref": "#/$defs/file" },
        "fixture": { "$ref": "#/$defs/file" },
        "prelude_files": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": { "$ref": "#/$defs/file" }
        },
        "gate": { "$ref": "#/$defs/optional_file" },
        "schema_contract": { "$ref": "#/$defs/optional_file" },
        "harness": { "$ref": "#/$defs/optional_file" },
        "windows_job": { "$ref": "#/$defs/optional_file" },
        "binary": { "$ref": "#/$defs/binary" },
        "build": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/command" }
        },
        "linker_binding": { "$ref": "#/$defs/linker_binding" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "subject",
        "binary_raw_sha256",
        "argv",
        "cwd",
        "timeout_seconds",
        "wall_ns",
        "exit_code",
        "timed_out",
        "measurement_errors",
        "stdout",
        "stderr"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "subject": { "$ref": "#/$defs/subject_name" },
        "binary_raw_sha256": { "$ref": "#/$defs/sha256" },
        "argv": { "$ref": "#/$defs/string_array" },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "const": 60 },
        "wall_ns": { "type": "integer", "minimum": 1 },
        "exit_code": { "type": "integer", "const": 0 },
        "timed_out": { "type": "boolean", "const": false },
        "measurement_errors": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "stdout": { "$ref": "#/$defs/file" },
        "stderr": { "$ref": "#/$defs/file" }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "order", "invocations"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/subject_name" }
        },
        "invocations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/invocation" }
        }
      }
    },
    "metric_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "median", "mad", "empirical_p95", "range"],
      "properties": {
        "count": { "type": "integer", "const": 41 },
        "median": { "type": "number" },
        "mad": { "type": "number", "minimum": 0 },
        "empirical_p95": { "type": "number" },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_wall_ns",
        "candidate_wall_ns",
        "candidate_minus_base_wall_ns",
        "candidate_over_base_ratio",
        "threshold_evaluation",
        "passed"
      ],
      "properties": {
        "base_wall_ns": { "$ref": "#/$defs/metric_stats" },
        "candidate_wall_ns": { "$ref": "#/$defs/metric_stats" },
        "candidate_minus_base_wall_ns": { "$ref": "#/$defs/metric_stats" },
        "candidate_over_base_ratio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "median"],
          "properties": {
            "count": { "type": "integer", "const": 41 },
            "median": { "type": "number", "minimum": 0 }
          }
        },
        "threshold_evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["median_ratio_at_most", "median_delta_ns_at_most"],
          "properties": {
            "median_ratio_at_most": { "type": "boolean" },
            "median_delta_ns_at_most": { "type": "boolean" }
          }
        },
        "passed": { "type": "boolean" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vorton.check-benchmark.invocation.v3",
  "title": "Vorton check benchmark invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "sample_id",
    "sample_dir",
    "case_id",
    "index",
    "included",
    "source_sha",
    "manifest_sha",
    "argv",
    "cwd",
    "cache",
    "runner_runtime",
    "root_pid",
    "wall_ns",
    "cpu_user_ns",
    "cpu_kernel_ns",
    "peak_root_rss_bytes",
    "sampled_peak_tree_rss_bytes",
    "max_worker_peak_rss_bytes",
    "peak_job_commit_bytes",
    "rss_poll_ms",
    "rss_samples_observed",
    "rss_covered_ns",
    "rss_coverage_ratio",
    "rss_observed_process_count",
    "rss_job_total_processes",
    "rss_complete",
    "process_count",
    "job_io",
    "timed_out",
    "measurement_errors",
    "exit",
    "stdout",
    "stderr",
    "runner_summary",
    "artifacts",
    "phase_traces",
    "invocation_error",
    "invalid_reason"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "vorton.check-benchmark.invocation.v3"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "sample_id": {
      "type": "string",
      "pattern": "[a-z][a-z0-9_]*-[0-9]{3}-[0-9a-f]{8}"
    },
    "sample_dir": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "index": { "type": "integer", "minimum": 0 },
    "included": { "type": "boolean" },
    "source_sha": { "type": "string", "minLength": 40 },
    "manifest_sha": { "type": "string", "minLength": 64 },
    "argv": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "cwd": { "type": "string", "minLength": 1 },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thinlto_cache", "output", "os_file_cache"],
      "properties": {
        "thinlto_cache": { "type": "string", "enum": ["cold", "warm"] },
        "output": { "type": "string", "const": "fresh" },
        "os_file_cache": { "type": "string", "const": "uncontrolled" }
      }
    },
    "runner_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "isolated",
        "root_path",
        "source_sha256",
        "flags",
        "original_exists",
        "original_sha256",
        "pre_exists",
        "pre_sha256",
        "post_exists",
        "post_sha256",
        "restored",
        "backup_path",
        "backup_exists_after",
        "staging_path",
        "staging_exists_after",
        "errors"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["not_applicable", "cold", "warm"]
        },
        "isolated": { "type": "boolean" },
        "root_path": { "type": ["string", "null"] },
        "source_sha256": { "type": ["string", "null"] },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "original_exists": { "type": "boolean" },
        "original_sha256": { "type": ["string", "null"] },
        "pre_exists": { "type": "boolean" },
        "pre_sha256": { "type": ["string", "null"] },
        "post_exists": { "type": "boolean" },
        "post_sha256": { "type": ["string", "null"] },
        "restored": { "type": "boolean" },
        "backup_path": { "type": ["string", "null"] },
        "backup_exists_after": { "type": "boolean" },
        "staging_path": { "type": ["string", "null"] },
        "staging_exists_after": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "root_pid": { "type": ["integer", "null"], "minimum": 0 },
    "wall_ns": { "type": ["integer", "null"], "minimum": 0 },
    "cpu_user_ns": { "type": ["integer", "null"], "minimum": 0 },
    "cpu_kernel_ns": { "type": ["integer", "null"], "minimum": 0 },
    "peak_root_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "sampled_peak_tree_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "max_worker_peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "peak_job_commit_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "rss_poll_ms": { "type": "integer", "const": 10 },
    "rss_samples_observed": { "type": "integer", "minimum": 0 },
    "rss_covered_ns": { "type": "integer", "minimum": 0 },
    "rss_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "rss_observed_process_count": { "type": "integer", "minimum": 0 },
    "rss_job_total_processes": { "type": "integer", "minimum": 0 },
    "rss_complete": { "type": "boolean" },
    "process_count": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["total", "active_at_query", "terminated"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "active_at_query": { "type": "integer", "minimum": 0 },
        "terminated": { "type": "integer", "minimum": 0 }
      }
    },
    "job_io": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "read_operations",
        "write_operations",
        "other_operations",
        "read_bytes",
        "write_bytes",
        "other_bytes"
      ],
      "properties": {
        "read_operations": { "type": "integer", "minimum": 0 },
        "write_operations": { "type": "integer", "minimum": 0 },
        "other_operations": { "type": "integer", "minimum": 0 },
        "read_bytes": { "type": "integer", "minimum": 0 },
        "write_bytes": { "type": "integer", "minimum": 0 },
        "other_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "timed_out": { "type": "boolean" },
    "measurement_errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "expected"],
      "properties": {
        "code": { "type": ["integer", "null"] },
        "expected": { "type": "boolean" }
      }
    },
    "stdout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 64 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "stderr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 64 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "runner_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status_counts", "suite_counts", "cases", "cases_sha256", "reported_exit_code"],
      "properties": {
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "fail", "skip"],
          "properties": {
            "pass": { "type": "integer", "minimum": 0 },
            "fail": { "type": "integer", "minimum": 0 },
            "skip": { "type": "integer", "minimum": 0 }
          }
        },
        "suite_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pass", "fail", "skip"],
            "properties": {
              "pass": { "type": "integer", "minimum": 0 },
              "fail": { "type": "integer", "minimum": 0 },
              "skip": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suite", "name", "status", "skip_reason"],
            "properties": {
              "suite": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
              "skip_reason": { "type": ["string", "null"] }
            }
          }
        },
        "cases_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reported_exit_code": { "type": ["integer", "null"] }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "exists", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "exists": { "type": "boolean" },
          "sha256": { "type": ["string", "null"] },
          "bytes": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "phase_traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "value", "read_error"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "value": { "type": ["object", "null"] },
          "read_error": { "type": ["string", "null"] }
        }
      }
    },
    "invocation_error": { "type": ["string", "null"] },
    "invalid_reason": { "type": ["string", "null"] }
  }
}

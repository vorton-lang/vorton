{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vorton:contract:format-1",
  "title": "Vorton contract format 1 — proposed input structure",
  "description": "Structural schema for the proposed vorton.contract format 1 input reader. The decoder additionally rejects duplicate object members, requires unsigned decimal integer tokens, and applies the documented finite nesting profile. Source binding, type/effect/ownership checking and declaration validity are separate Checker responsibilities.",
  "type": "object",
  "properties": {"format":{"const":"vorton.contract"},"format_version":{"const":1},"semantics_version":{"const":"0.1"},"owner":{"type":"string","minLength":1},"records":{"type":"array","items":{"$ref":"#/$defs/Record"}},"display":{"$ref":"#/$defs/Display"}},

    "EntityRef": {"oneOf":[{"type":"object","properties":{"tag":{"const":"declaration"},"declaration":{"$ref":"#/$defs/DeclRef"}},"required":["tag","declaration"],"additionalProperties":false},{"$ref":"#/$defs/TraitMemberRef"},{"$ref":"#/$defs/ImplMemberRef"},{"type":"object","properties":{"tag":{"const":"impl"},"implementation":{"$ref":"#/$defs/ImplRef"}},"required":["tag","implementation"],"additionalProperties":false}]},

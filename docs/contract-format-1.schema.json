    "TypePattern": {"oneOf":[{"type":"object","properties":{"tag":{"const":"primitive"},"name":{"enum":["Int","Float","Str","Bool","Unit","Never"]}},"required":["tag","name"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"ptr"},"pointee":{"$ref":"#/$defs/TypePattern"}},"required":["tag","pointee"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"nominal"},"declaration":{"$ref":"#/$defs/DeclRef"},"arguments":{"type":"array","items":{"$ref":"#/$defs/TypePattern"}}},"required":["tag","declaration","arguments"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"local_type_parameter"},"index":{"$ref":"#/$defs/Index"}},"required":["tag","index"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"tuple"},"elements":{"type":"array","items":{"$ref":"#/$defs/TypePattern"},"minItems":2}},"required":["tag","elements"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"associated"},"base":{"$ref":"#/$defs/TypePattern"},"trait":{"$ref":"#/$defs/PatternTrait"},"name":{"$ref":"#/$defs/Identifier"}},"required":["tag","base","trait","name"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"list"},"element":{"$ref":"#/$defs/TypePattern"}},"required":["tag","element"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"range"},"element":{"$ref":"#/$defs/TypePattern"}},"required":["tag","element"],"additionalProperties":false}]},

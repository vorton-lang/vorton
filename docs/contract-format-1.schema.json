    "ImplAllowance": {"type":"object","properties":{"implementation":{"$ref":"#/$defs/ImplRef"},"predicates":{"type":"array","items":{"$ref":"#/$defs/PatternPredicate"}}},"required":["implementation","predicates"],"additionalProperties":false},

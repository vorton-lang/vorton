    "TypeFormalRef": {"allOf":[{"$ref":"#/$defs/FormalRef"},{"properties":{"kind":{"const":"type"}}}]},
    "EffectFormalRef": {"allOf":[{"$ref":"#/$defs/FormalRef"},{"properties":{"kind":{"const":"effect"}}}]},
    "ParameterRef": {"oneOf":[{"type":"object","properties":{"tag":{"const":"receiver"}},"required":["tag"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"position"},"index":{"$ref":"#/$defs/Index"}},"required":["tag","index"],"additionalProperties":false}]},
    "TraitUse": {"type":"object","properties":{"trait":{"$ref":"#/$defs/TraitRef"},"arguments":{"type":"array","items":{"$ref":"#/$defs/Type"}},"associated_bindings":{"type":"array","items":{"type":"object","properties":{"name":{"$ref":"#/$defs/Identifier"},"type":{"$ref":"#/$defs/Type"}},"required":["name","type"],"additionalProperties":false}}},"required":["trait","arguments","associated_bindings"],"additionalProperties":false},
    "Type": {"oneOf":[{"type":"object","properties":{"tag":{"const":"primitive"},"name":{"enum":["Int","Float","Str","Bool","Unit","Never"]}},"required":["tag","name"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"ptr"},"pointee":{"$ref":"#/$defs/Type"}},"required":["tag","pointee"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"nominal"},"declaration":{"$ref":"#/$defs/DeclRef"},"arguments":{"type":"array","items":{"$ref":"#/$defs/Type"}}},"required":["tag","declaration","arguments"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"formal"},"formal":{"$ref":"#/$defs/TypeFormalRef"}},"required":["tag","formal"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"tuple"},"elements":{"type":"array","items":{"$ref":"#/$defs/Type"},"minItems":2}},"required":["tag","elements"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"associated"},"base":{"$ref":"#/$defs/Type"},"trait":{"$ref":"#/$defs/TraitUse"},"name":{"$ref":"#/$defs/Identifier"}},"required":["tag","base","trait","name"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"function_item"},"function":{"$ref":"#/$defs/FunctionRef"},"owner_type_arguments":{"type":"array","items":{"$ref":"#/$defs/Type"}},"type_arguments":{"type":"array","items":{"$ref":"#/$defs/Type"}},"effect_arguments":{"type":"array","items":{"$ref":"#/$defs/EffectRow"}}},"required":["tag","function","owner_type_arguments","type_arguments","effect_arguments"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"opaque_callable"},"function":{"$ref":"#/$defs/FunctionRef"},"owner_type_arguments":{"type":"array","items":{"$ref":"#/$defs/Type"}},"type_arguments":{"type":"array","items":{"$ref":"#/$defs/Type"}},"effect_arguments":{"type":"array","items":{"$ref":"#/$defs/EffectRow"}}},"required":["tag","function","owner_type_arguments","type_arguments","effect_arguments"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"list"},"element":{"$ref":"#/$defs/Type"}},"required":["tag","element"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"range"},"element":{"$ref":"#/$defs/Type"}},"required":["tag","element"],"additionalProperties":false},{"type":"object","properties":{"tag":{"const":"self_type"},"owner":{"$ref":"#/$defs/SelfOwner"}},"required":["tag","owner"],"additionalProperties":false}]},

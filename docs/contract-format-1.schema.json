    "ParameterModeSet": {"type":"object","properties":{"parameter":{"$ref":"#/$defs/ParameterRef"},"mode":{"$ref":"#/$defs/ModeRule"}},"required":["parameter","mode"],"additionalProperties":false},
    "ParameterEscapeSet": {"type":"object","properties":{"parameter":{"$ref":"#/$defs/ParameterRef"},"escape":{"$ref":"#/$defs/EscapeRule"}},"required":["parameter","escape"],"additionalProperties":false},
    "Set": {"type":"object","properties":{"parameter_types":{"type":"array","items":{"$ref":"#/$defs/ParameterTypeSet"},"minItems":1},"return_type":{"$ref":"#/$defs/Type"},"parameter_modes":{"type":"array","items":{"$ref":"#/$defs/ParameterModeSet"},"minItems":1},"parameter_escape":{"type":"array","items":{"$ref":"#/$defs/ParameterEscapeSet"},"minItems":1},"effect_upper":{"$ref":"#/$defs/EffectRow"},"generic_requirements":{"type":"array","items":{"$ref":"#/$defs/GenericRequirement"}}},"required":[],"additionalProperties":false,"minProperties":1},
    "Visibility": {"enum":["public","private"]},

use parser
use parser as p
pub use parser::{Token as T, parse}

effect alias Host = {console, fs}

pub effect Logger<T> {
    fn log(value: T) -> Unit;
}

extern type Handle<T>
extern fn host(value: Int) -> Int with {process}
type Pair<T> = (T, T)
type Wrapped<T> = (T)
const LIMIT: Int = 10

pub struct Point<T> {
    pub x: T,
    y: T,
}

enum Maybe<T> {
    none,
    some(T),
    named { value: T },
}

trait Show: Debug {
    type Item: Eq = Int
    fn show(self: Self) -> Str with {};
}

impl<T> Point<T> {
    pub type Item = T
    pub fn shift(mut self, delta: T) -> Point<T> {
        self
    }
}

impl<T> Show for Point<T> {
    type Item = T
    fn show(self: Self) -> Str with {} {
        "point"
    }
}

mod inner requires {console} {
    use parser
    pub fn value() -> Int { 1 }
}

test "surface" {
    let value = 1
    value
}

fn exercise(base: Point<Int>, opt: Maybe<Int>) -> Int {
    let mut x: Int = 1
    let floating = 3.5
    let tuple = (x, 2)
    let parenthesized = (x)
    let raw = r"raw\n"
    let interpolated = "x=${x}, nested=${"${x}"}"
    let list = [x, 2, 3]
    let first = list[0]
    let field = base.x
    let tuple_field = tuple.0
    let call = host(x)
    let method = interpolated.len()
    let lambda: fn(Int) -> Int with {} = fn(value: Int) -> Int { value + 1 }
    let rebuilt = Point { ..base, x: call, y: first }
    let ranged = 1..=LIMIT
    let unary = -x + !false
    x += 1
    x -= 1
    x *= 2
    x /= 2
    x %= 2
    if let some(value) = opt {
        x = value
    } else {
        x = 0
    }
    while x < 3 {
        x = x + 1
        continue
    }
    loop {
        break
    }
    for (left, right) in [(1, 2)] {
        x = left + right
    }
    let selected = if x == 0 { 1 } else if x > 0 { 2 } else { 3 }
    let matched = match opt {
        some(value) if value > 0 => value,
        none | some(_) => 0,
    }
    let tuple_matched = match tuple {
        (left, right) => left + right,
    }
    let named_matched = match rebuilt {
        Point { x: value, .. } => value,
    }
    let literal_matched = match x {
        1 | 2 => 1,
        _ => 0,
    }
    let handled = handle {
        Logger.log("hello");
        1
    } with {
        Logger.log(message) => (),
    }
    let caught = host(x) catch { _ => 0 }
    let discharged = unsafe { x }
    return parenthesized + selected + matched + tuple_matched + named_matched + literal_matched + caught + discharged
}

fn record_value<T>(item: {x: T, ..rest}) -> T {
    item.x
}

effect FileAccess {
    fn read(path: Str) -> Str
}

fn load(path: Str) -> Str with {FileAccess} {
    FileAccess.read(path)
}

fn load_from_os(path: Str) -> Str with {fs} {
    handle {
        load(path)
    } with {
        FileAccess.read(actual_path) => read_file(actual_path),
    }
}

fn main() {
    let value = handle {
        load("settings.vorton")
    } with {
        FileAccess.read(path) => "mock:${path}",
    }
    assert(value == "mock:settings.vorton", "custom effect adapter")
}

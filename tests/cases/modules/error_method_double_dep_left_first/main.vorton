use left::{Shared as LeftShared, make_left}
use right::{Shared as RightShared, make_right}

fn left_value(value: LeftShared) -> Int { value.value }
fn right_value(value: RightShared) -> Int { value.value }

fn main() {
    let _left = left_value(make_left())
    let _right = right_value(make_right())
}

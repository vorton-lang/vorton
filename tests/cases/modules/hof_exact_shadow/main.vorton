use facade::{display, make_cell, direct}

fn apply(f: fn(Int) -> Int, value: Int) -> Int {
    f(value)
}

fn main() {
    // The source leafs deliberately collide with prelude `print` and `Cell`.
    // Exact exported DefId provenance must keep both values as Vorton callables,
    // including the re-export aliases, rather than selecting builtin behavior.
    let printed = apply(display, 41)
    let celled = apply(make_cell, 40)
    print(printed + celled)
    print(direct(1))
}

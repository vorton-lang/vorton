use defs
use defs::{Raw, keep_before, keep_after}

// Direct calls lock both explicitly annotated functions to the raw nominal.
// They are type-checked but deliberately not executed: no raw allocator or
// runtime representation is needed for this namespace regression.
fn direct_before(value: Raw) -> Raw with {} { keep_before(value) }
fn direct_after(value: Raw) -> Raw with {} { keep_after(value) }

fn keep_callback(callback: fn(Raw) -> Raw) -> fn(Raw) -> Raw {
    callback
}

fn main() {
    // First-class values lock the exported schemes as raw -> raw on both sides
    // of the inline facade declaration in defs.vorton.
    let before: fn(Raw) -> Raw = keep_callback(keep_before)
    let after: fn(Raw) -> Raw = keep_callback(keep_after)
    let direct_before_value: fn(Raw) -> Raw = direct_before
    let direct_after_value: fn(Raw) -> Raw = direct_after
    print("inline re-export raw annotation stability")
}

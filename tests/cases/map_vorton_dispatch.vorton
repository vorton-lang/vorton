// B-152 P3 closure: every Map family operation must dispatch to std/map.vorton.
// The generic wrappers force Hash + Eq dictionaries to be forwarded through
// bounded methods, subscript lowering, and the source-level map_get_panic API.

struct Key { id: Int }

impl Hash for Key {
    // Deliberately collide so growth/rehash exercises long probe chains.
    fn hash(self) -> Int { self.id % 3 }
}

struct LabeledKey { id: Int, label: Str }

impl Hash for LabeledKey {
    fn hash(self) -> Int { self.id }
}

impl Eq for LabeledKey {
    fn eq(self, other: LabeledKey) -> Bool { self.id == other.id }
}

mod top_shadow_compatible {
    fn map_get_panic(_: Map<Key, Int>, _: Key) -> Int { -777 }

    pub fn run() -> Int {
        let m = map_from([(Key { id: 14 }, 140)])
        m[Key { id: 14 }]
    }
}

mod top_shadow_incompatible {
    const map_get_panic: Str = "not callable"

    pub fn run() -> Int {
        let m = map_from([(Key { id: 15 }, 150)])
        m[Key { id: 15 }]
    }
}

impl Eq for Key {
    fn eq(self, other: Key) -> Bool { self.id == other.id }
}

fn insert_and_index<K: Hash + Eq>(
    mut m: Map<K, Int>, write_key: K, read_key: K
) -> Int {
    m.insert(write_key, 40)
    m[read_key] + 2
}

fn source_api_get<K: Hash + Eq>(m: Map<K, Int>, key: K) -> Int {
    // The raw prelude alias must retain the canonical scheme/DefId so both
    // custom key dictionaries are forwarded through this ordinary source call.
    map_get_panic(m, key)
}

fn make_keyed_map() -> Map<Key, Int> {
    let mut m: Map<Key, Int> = map_new()
    m.insert(Key { id: 9 }, 90)
    m
}

fn overwrite_equal_keys() {
    let mut structs: Map<Key, Int> = map_new()
    let mut strings: Map<Str, Int> = map_new()
    let mut i = 0
    while i < 64 {
        structs.insert(Key { id: 5 }, i)
        strings.insert("same", i)
        i = i + 1
    }
    print(structs.len())
    print(structs[Key { id: 5 }])
    print(strings.len())
    print(strings["same"])

    // Equal-but-not-identical keys preserve the first inserted key object.
    let mut labeled: Map<LabeledKey, Int> = map_new()
    labeled.insert(LabeledKey { id: 1, label: "first" }, 10)
    labeled.insert(LabeledKey { id: 1, label: "second" }, 20)
    print(labeled.keys()[0].label)
    print(labeled[LabeledKey { id: 1, label: "lookup" }])
}

fn shadow_compatible(
    map_get_panic: fn(Map<Key, Int>, Key) -> Int
) -> Int {
    let m = map_from([(Key { id: 12 }, 120)])
    // The compatible parameter must not redirect synthetic [] lowering.
    m[Key { id: 12 }]
}

fn shadow_local_compatible() -> Int {
    let map_get_panic: fn(Map<Key, Int>, Key) -> Int = fn(_, _) { -888 }
    let m = map_from([(Key { id: 16 }, 160)])
    m[Key { id: 16 }]
}

fn shadow_incompatible() -> Int {
    let map_get_panic = "not a function"
    let m = map_from([(Key { id: 13 }, 130)])
    // The incompatible local must not participate in type inference either.
    m[Key { id: 13 }]
}

fn shadow_param_incompatible(map_get_panic: Str) -> Int {
    let m = map_from([(Key { id: 17 }, 170)])
    m[Key { id: 17 }]
}

fn grow_rehash_collision() {
    let mut m: Map<Key, Int> = map_new()
    let mut i = 0
    while i < 48 {
        m.insert(Key { id: i }, i * 10)
        i = i + 1
    }
    i = 0
    while i < 16 {
        m.remove(Key { id: i })
        i = i + 1
    }
    i = 48
    while i < 72 {
        m.insert(Key { id: i }, i * 10)
        i = i + 1
    }
    let mut total = 0
    for (_, v) in m {
        total = total + v
    }
    print(m.len())
    print(m[Key { id: 17 }])
    print(m[Key { id: 71 }])
    print(total)
}

fn exercise_hof_reads() {
    let m = map_from([
        (Key { id: 21 }, 2),
        (Key { id: 22 }, 3),
        (Key { id: 23 }, 4)
    ])
    print(m.keys().len())
    print(m.values().fold(0, fn(acc, v) { acc + v }))
    print(m.entries().len())
    print(m.fold(1, fn(acc, _, v) { acc * v }))
    print(m.any(fn(_, v) { v == 3 }))
    print(m.filter(fn(_, v) { v >= 3 }).len())
    print(m.map_values(fn(v) { v * 10 })[Key { id: 23 }])
}

fn list_replace_regression() {
    let mut xs = ["old", "keep"]
    let saved = xs[0]
    xs.set(0, "new")
    print("${xs[0]} ${saved}")
    xs.set(0, xs[0])
    print("${xs[0]} ${xs[1]}")
}

fn map_replace_regression() {
    let mut m = map_from([("key", "old"), ("other", "keep")])
    let saved = m["key"]
    m.insert("key", "new")
    print("${m["key"]} ${saved}")
    m.insert("key", m["key"])
    print("${m["key"]} ${m["other"]}")
}

fn main() {
    // The inserted key's source scope ends before this lookup.  Without
    // acquiring ownership at the vorton_slot_write boundary, this dereferences
    // a freed key in Hash dispatch.
    let escaped = make_keyed_map()
    print(escaped[Key { id: 9 }])
    overwrite_equal_keys()
    print(shadow_compatible(fn(_, _) { -999 }))
    print(shadow_local_compatible())
    print(shadow_incompatible())
    print(shadow_param_incompatible("not callable"))
    print(top_shadow_compatible::run())
    print(top_shadow_incompatible::run())
    grow_rehash_collision()
    exercise_hof_reads()
    map_replace_regression()
    list_replace_regression()

    let mut m: Map<Key, Int> = map_new()
    print(insert_and_index(m, Key { id: 7 }, Key { id: 7 }))

    m.insert(Key { id: 1 }, 10)
    let mut copied = map_clone(m)
    print(copied.get(Key { id: 1 }).unwrap_or(-1))
    print(source_api_get(copied, Key { id: 1 }))

    let mut total = 0
    for (k, v) in copied {
        total = total + v
    }
    print(total)

    copied.remove(Key { id: 7 })
    print(copied.contains_key(Key { id: 7 }))
    copied.clear()
    print(copied.is_empty())

    let from = map_from([(Key { id: 3 }, 30)])
    print(from[Key { id: 3 }])
}

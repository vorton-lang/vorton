// C-native regression: recursion, &&/|| (andor_lower path),
// early return (incl. return inside an expression block), nested control flow
// with break/continue, float arithmetic, string comparison chains.
// Deliberately restricted to the step 1-3 feature surface (literals,
// arithmetic/comparison, locals, calls, if/while/for/block) so it runs on
// BOTH backends during the B-163 port — differential-oracle coverage for the
// C backend's first wave.

fn fib(n: Int) -> Int {
    if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

fn gcd(a: Int, b: Int) -> Int {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn classify(n: Int) -> Str {
    if n < 0 { return "neg" }
    if n == 0 { return "zero" }
    if n % 2 == 0 && n > 10 { return "big-even" }
    if n % 2 == 1 || n > 100 { "oddish" } else { "small-even" }
}

fn early(n: Int) -> Int {
    let v = {
        if n > 10 { return 99 }
        n * 2
    }
    v + 1
}

fn main() {
    // recursion
    print("fib10=${fib(10)}")
    print("gcd=${gcd(48, 36)}")

    // early returns + &&/|| in branch conditions
    print(classify(-5))
    print(classify(0))
    print(classify(12))
    print(classify(7))
    print(classify(4))

    // &&/|| bound as values (andor_lower IfExpr materialisation)
    let a = 3
    let b = 4
    let both = a < b && b < 10
    let either = a > b || b == 4
    print("both=${both} either=${either}")
    print("not=${!(a < b)}")

    // nested while/for with continue (outer) and break (inner)
    let mut total = 0
    let mut i = 0
    while i < 6 {
        i = i + 1
        if i == 2 { continue }
        for j in 0..i {
            if j == 4 { break }
            total = total + j
        }
    }
    print("total=${total}")

    // float arithmetic + comparisons
    let x = 2.5
    let y = 0.5
    print("fadd=${x + y} fsub=${x - y} fmul=${x * y} fdiv=${x / y}")
    print("fcmp=${x > y} ${x <= y} ${x == 2.5}")

    // string comparison chains
    let s = "vorton"
    print("scmp=${s == "vorton"} ${s != "rust"} ${s < "s"} ${s >= "r"}")

    // return inside an expression block
    print("er=${early(3)} ${early(30)}")
}

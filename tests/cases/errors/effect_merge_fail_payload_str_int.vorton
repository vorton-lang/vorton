// expect-error: E0301
// Vorton has one fail payload per effect row. The first branch fixes the
// retained row entry to Str, so the Int branch must be rejected before
// kind-based row deduplication can erase the conflict.

fn raise_text() -> Int with {fail<Str>} {
    fail.raise("text")
}

fn raise_number() -> Int with {fail<Int>} {
    fail.raise(7)
}

fn branch_fail(flag: Bool) -> Int with {fail<Str>} {
    if flag {
        raise_text()
    } else {
        raise_number()
    }
}

fn main() {
    let result = branch_fail(true) catch { _ => 0 }
    print(result.to_str())
}

// These user declarations deliberately reuse every compiler-owned bridge leaf
// spelling with unrelated source identities and signatures. A typed manifest
// must ignore all ten while still closing its own 10/10 site inventory.
mod user_bridge {
    pub extern fn vorton_slot_alloc<T>(value: T) -> Int
    pub extern fn vorton_slot_dealloc<T>(value: T) -> Int
    pub extern fn vorton_slot_read<T>(value: T) -> Int
    pub extern fn vorton_slot_take<T>(value: T) -> Int
    pub extern fn vorton_slot_write<T>(value: T) -> Int
    pub extern fn vorton_slot_replace<T>(value: T) -> Int
    pub extern fn vorton_slot_swap<T>(value: T) -> Int
    pub extern fn vorton_slot_move<T>(value: T) -> Int
    pub extern fn vorton_slot_drop<T>(value: T) -> Int
    pub extern fn vorton_list_sort_bridge<T>(value: T) -> Int
}

fn main() {
    print("E_USER_EXTERN_SPELLING_OK")
}

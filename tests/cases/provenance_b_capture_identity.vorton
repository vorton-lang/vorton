fn __vorton_T_Ord(mut value: Int) -> Int {
    value = value + 10
    value
}

fn direct_global_with_ord_evidence<T: Ord>(left: T, right: T) -> Int {
    if left < right { __vorton_T_Ord(5) } else { 0 }
}

fn nested_trait_collision<T: Ord>(left: T, right: T) -> Bool {
    let __vorton_T_Ord = fn(value: Int) -> Int { value + 1 }
    let outer = fn() -> Bool {
        let inner = fn() -> Bool {
            __vorton_T_Ord(1) == 2 && left < right
        }
        inner()
    }
    outer()
}

trait ProvenanceTrait {
    fn base(self) -> Int
    fn combined(self) -> Int
}

struct ProvenanceCarrier {}

impl ProvenanceTrait for ProvenanceCarrier {
    fn base(self) -> Int { 4 }
    fn combined(self) -> Int {
        let __vorton_self_ProvenanceTrait = fn() -> Int { 3 }
        let outer = fn() -> Int {
            let inner = fn() -> Int {
                __vorton_self_ProvenanceTrait() + self.base()
            }
            inner()
        }
        outer()
    }
}

effect E {
    fn read() -> Int
}

fn nested_effect_collision() -> Int with {E} {
    let __vorton_ev_E = fn() -> Int { 5 }
    let outer = fn() -> Int {
        let inner = fn() -> Int {
            __vorton_ev_E() + E.read()
        }
        inner()
    }
    outer()
}

trait dictlocal_1 {
    fn mark(self) -> Int
}

enum vorton {
    marker
}

impl dictlocal_1 for vorton {
    fn mark(self) -> Int { 9 }
}

struct ProvenanceBox<T> {
    value: T
}

fn combine_dicts<U: Eq, V: dictlocal_1>(left: U, right: U, marker: V) -> Bool {
    left == right && marker.mark() == 9
}

fn dynamic_static_dict_collision<T: Eq>(left: T, right: T) -> Bool {
    let marker = vorton::marker
    combine_dicts(
        ProvenanceBox { value: left },
        ProvenanceBox { value: right },
        marker
    )
}

fn main() {
    print(__vorton_T_Ord(5))
    print(direct_global_with_ord_evidence(1, 2))
    print(nested_trait_collision(1, 2))
    print(ProvenanceCarrier {}.combined())
    let effect_value = handle {
        nested_effect_collision()
    } with {
        E.read() => 7,
    }
    print(effect_value)
    print(dynamic_static_dict_collision(3, 3))
}

// `match &x`, `match &mut x` and `if let` with a borrowed subject bind into
// the matched place: nothing is moved, and changes through `&mut` bindings
// stay in the place.
enum Shape {
    Circle(Int),
    Rect { w: Int, h: Int },
    Label(Str),
}

enum State {
    Running { timer: Int, log: List<Str> },
    Paused,
}

struct World { state: State, shapes: List<Shape> }

fn area(s: &Shape) -> Int {
    match &s {
        Shape::Circle(r) => 3 * r * r
        Shape::Rect { w, h } => w * h
        Shape::Label(_) => 0
    }
}

fn make() -> (Int, List<Int>) {
    (5, [1, 2])
}

fn main() {
    let mut world = World {
        state: State::Running { timer: 10, log: [] },
        shapes: [Shape::Circle(2), Shape::Rect { w: 3, h: 4 }, Shape::Label("hi")],
    }
    for step in 0..3 {
        match &mut world.state {
            State::Running { timer, log } => {
                timer -= step
                log.push("step ${step}")
            }
            State::Paused => {}
        }
    }
    match &world.state {
        State::Running { timer, log } => print("${timer} ${log.len()}")
        State::Paused => print("paused")
    }
    for s in &mut world.shapes {
        match &mut s {
            Shape::Circle(r) if r > 1 => {
                r = r * 10
            }
            Shape::Rect { w, .. } => {
                w += 1
            }
            Shape::Label(text) => {
                text = "${text}!"
            }
            _ => {}
        }
    }
    for s in &world.shapes {
        print(area(&s))
    }
    if let Shape::Label(text) = &world.shapes[2] {
        print(text)
    }
    if let State::Running { log, .. } = &mut world.state {
        log.clear()
    } else {
        print("paused")
    }
    world.state = State::Paused
    if let State::Running { .. } = &world.state {
        print("running")
    } else {
        print("paused now")
    }
    // A borrowed temporary lives until the statement ends.
    match &mut make() {
        (n, xs) => {
            xs.push(n)
            print(xs.len())
        }
    }
}

// Test: for (k, v) in map — Map destructuring iteration
fn main() {
    let m = {
        let mut entries: Map<Int, Str> = Map::new()
        entries.insert(1, "one")
        entries.insert(2, "two")
        entries.insert(3, "three")
        entries
    }
    let mut total = 0
    for (k, v) in m {
        total = total + k
    }
    print(total)
}

// expect: 6

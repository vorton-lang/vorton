// A function may return `&` or `&mut` of a place that comes from a
// parameter passed by borrow. The call is then that place: it can be read,
// changed, borrowed again or bound with `let`, and its borrowed arguments
// stay borrowed while the result is used.
struct Item { name: Str, count: Int }

struct Inventory { items: List<Item>, gold: Int }

fn items(inv: &Inventory) -> &List<Item> {
    &inv.items
}

fn items_mut(inv: &mut Inventory) -> &mut List<Item> {
    &mut inv.items
}

fn gold(inv: &mut Inventory) -> &mut Int {
    &mut inv.gold
}

fn find(items: &mut List<Item>, name: Str) -> &mut Item {
    for item in &mut items {
        if item.name == name {
            return &mut item
        }
    }
    panic("no ${name}")
}

fn first_name(inv: &Inventory) -> &Str {
    &items(&inv)[0].name
}

fn pick(a: &mut Item, b: &mut Item, first: Bool) -> &mut Item {
    if first {
        return &mut a
    }
    &mut b
}

fn add(n: &mut Int, amount: Int) {
    n += amount
}

fn main() {
    let mut inv = Inventory { items: [], gold: 5 }
    items_mut(&mut inv).push(Item { name: "sword", count: 1 })
    items_mut(&mut inv).push(Item { name: "arrow", count: 20 })
    print(items(&inv).len())
    let arrows = find(&mut inv.items, "arrow")
    arrows.count -= 3
    add(&mut find(&mut inv.items, "sword").count, 1)
    print("${inv.items[0].count} ${inv.items[1].count}")
    add(&mut gold(&mut inv), 10)
    let g = gold(&mut inv)
    g *= 2
    print(inv.gold)
    print(first_name(&inv))
    let xs = items(&inv)
    for item in &xs {
        print("${item.name}:${item.count}")
    }
    let mut a = Item { name: "a", count: 0 }
    let mut b = Item { name: "b", count: 0 }
    add(&mut pick(&mut a, &mut b, false).count, 7)
    let p = pick(&mut a, &mut b, true)
    p.count += 1
    print("${a.count} ${b.count}")
}

// Builds, reassigns and returns strings along every exit path so the leak
// check sees each string released exactly once.
fn label(n: Int) -> Str {
    if n % 3 == 0 {
        return "fizz"
    }
    let text = "n=${n}"
    text
}

fn pick(flag: Bool, a: Str, b: Str) -> Str {
    if flag { a } else { b }
}

fn first_long(limit: Int) -> Str {
    let mut i = 0
    loop {
        let candidate = "item ${i}"
        if i >= limit {
            return candidate
        }
        i += 1
    }
}

fn main() {
    let mut acc = ""
    let mut i = 0
    while i < 5 {
        let piece = label(i)
        acc = "${acc}[${piece}]"
        i += 1
        if i == 4 {
            continue
        }
    }
    print(acc)
    let chosen = pick(i > 3, "yes", acc)
    print(chosen)
    let block = {
        let inner = "inner ${chosen}"
        inner
    }
    print(block)
    let mut s = "a${1}"
    s = s
    print(s)
    print(first_long(3))
    print(pick(false, "unused", label(7)))
}
// A match that binds one part of a variable takes only that part; the rest
// stays and is released when the variable ends.
struct Guard { tag: Str }

impl Drop for Guard {
    fn drop(&mut self) {
        assert(false, "dropped ${self.tag}")
    }
}

fn main() {
    let pair = ([1, 2], Guard { tag: "rest" })
    match pair {
        (items, _) => print("bound ${items.len()}")
    }
    print("after the match")
}
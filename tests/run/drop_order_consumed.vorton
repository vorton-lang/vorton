// A value passed by value is released when the callee that owns it returns,
// before the caller goes on.
struct Guard { tag: Str }

impl Drop for Guard {
    fn drop(&mut self) {
        assert(false, "dropped ${self.tag}")
    }
}
fn consume(guard: Guard) {
    print("consuming ${guard.tag}")
}

fn main() {
    consume(Guard { tag: "argument" })
    print("after the call")
}

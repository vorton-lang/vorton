// B-152: bridge functions for StringBuilder RIIR (raw-memory ops in C)
extern fn vorton_str_as_ptr(s: Str) -> Ptr<Int>
extern fn vorton_str_from_ptr(p: Ptr<Int>, len: Int) -> Str
extern fn vorton_buf_alloc(cap: Int) -> Ptr<Int>
extern fn vorton_buf_dealloc(p: Ptr<Int>) -> Unit
extern fn vorton_buf_grow(old: Ptr<Int>, old_len: Int, new_cap: Int) -> Ptr<Int>
extern fn vorton_buf_copy_at(dst: Ptr<Int>, offset: Int, src: Ptr<Int>, len: Int) -> Unit
extern fn vorton_buf_set_byte(p: Ptr<Int>, offset: Int, val: Int) -> Unit

pub struct StringBuilder {
    buf: Ptr<Int>
    len: Int
    cap: Int
}

impl Drop for StringBuilder {
    fn drop(self) {
        vorton_buf_dealloc(self.buf)
    }
}

pub fn string_builder() -> StringBuilder {
    let initial_cap = 64
    StringBuilder {
        buf: vorton_buf_alloc(initial_cap),
        len: 0,
        cap: initial_cap
    }
}

impl StringBuilder {
    fn ensure_cap(mut self, needed: Int) {
        if needed <= self.cap { return () }
        let new_cap = if self.cap * 2 > needed { self.cap * 2 } else { needed }
        self.buf = vorton_buf_grow(self.buf, self.len, new_cap)
        self.cap = new_cap
    }

    pub fn add(mut self, s: Str) -> Unit {
        let slen = s.len()
        self.ensure_cap(self.len + slen)
        let src = vorton_str_as_ptr(s)
        vorton_buf_copy_at(self.buf, self.len, src, slen)
        self.len = self.len + slen
    }

    pub fn to_str(self) -> Str {
        vorton_str_from_ptr(self.buf, self.len)
    }

    pub fn len(self) -> Int { self.len }

    pub fn add_int(mut self, n: Int) -> Unit {
        self.add(n.to_str())
    }

    pub fn line(mut self, s: Str) -> Unit {
        self.add(s)
        self.ensure_cap(self.len + 1)
        vorton_buf_set_byte(self.buf, self.len, 10)
        self.len = self.len + 1
    }
}

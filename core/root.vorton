pub enum Option<T> {
    Some(T),
    None,
}

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub trait PartialEq {
    fn eq(&self, other: &Self) -> Bool with {}
}

pub trait Eq: PartialEq {}

pub trait PartialOrd: PartialEq {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> with {}
}

pub trait Ord: Eq + PartialOrd {
    fn cmp(&self, other: &Self) -> Ordering with {}
}

pub trait Drop {
    fn drop(&mut self) -> Unit
}

pub trait Clone {
    fn clone(&self) -> Self
}

pub trait Copy: Clone {}

pub trait Display {
    fn to_str(&self) -> Str
}

pub trait Debug {
    fn debug(&self) -> Str
}

pub trait Hash {
    fn hash(&self) -> Int
}

pub trait Iterator {
    type Item
    fn next(&mut self) -> Option<Self::Item>
}

pub trait Iterable {
    type Item
    type Iter: Iterator<Item = Self::Item>
    fn iter(&self) -> Self::Iter
}

pub enum Option<T> {
    Some(T),
    None,
}

pub enum Ordering {
    Less,
    Equal,
    Greater,
}

pub trait PartialEq {
    fn eq(self: &Self, other: &Self) -> Bool with {};
}

pub trait Eq: PartialEq {}

pub trait PartialOrd: PartialEq {
    fn partial_cmp(self: &Self, other: &Self) -> Option<Ordering> with {};
}

pub trait Ord: Eq + PartialOrd {
    fn cmp(self: &Self, other: &Self) -> Ordering with {};
}

pub trait Clone {
    fn clone(self: &Self) -> Self;
}

pub trait Copy: Clone {}

pub trait Drop {
    fn drop(self: &mut Self) -> Unit;
}

pub trait Display {
    fn to_str(self: &Self) -> Str;
}

pub trait Debug {
    fn debug(self: &Self) -> Str;
}

pub trait Hash {
    fn hash(self: &Self) -> Int;
}

pub trait FnOnce {}

pub trait FnMut: FnOnce {}

pub trait Fn: FnMut {}

pub trait Iterator {
    type Item;
    fn next(self: &mut Self) -> Option<Self::Item>;
}

pub trait Iterable {
    type Item;
    type Iter: Iterator<Item = Self::Item>;
    fn iter(self: move Self) -> Self::Iter;
}
